{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "public-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
