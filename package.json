{
  "name": "cloudflare-os-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "vp run -r --cache build",
    "test": "node --test 'scripts/**/*.test.ts' && vp run --filter '!cloudflare-os-starter' --cache test",
    "types:scripts": "tsc -p scripts/tsconfig.json",
    "lint:check": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint": "pnpm run lint:check && pnpm run types:scripts && pnpm run build",
    "check": "node scripts/deploy.ts --check",
    "deploy": "node scripts/deploy.ts",
    "lint:custom": "oxlint scripts packages",
    "lint:custom:fix": "oxlint --fix scripts packages",
    "types:check": "pnpm --filter custom-gatekeeper types:check && pnpm --filter error-reporter types:check && pnpm --filter public-chat types:check && pnpm --filter s3v-explorer types:check"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@types/node": "26.1.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:",
    "oxlint": "1.76.0",
  }
}
